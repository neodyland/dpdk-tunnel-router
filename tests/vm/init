#!/bin/bash
# QEMU guest init for dpdk-tunnel-router tests.
# All test binaries are prebuilt on the host and executed inside this VM.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export LD_LIBRARY_PATH=/usr/local/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu
export XDG_RUNTIME_DIR=/run
export TMPDIR=/tmp
export TR_PLUGIN=/project/build/rust/release/libtunnel_driver.so

fail() {
    echo "INIT_FAIL: $*"
    echo "VM_TESTS_FAIL"
    sync
    poweroff -f 2>/dev/null || true
    sleep 5
    exit 1
}

mount -t proc proc /proc || fail "mount proc"
mount -t sysfs sysfs /sys || fail "mount sysfs"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || fail "mount devtmpfs"
mount -t tmpfs tmpfs /tmp 2>/dev/null || fail "mount tmp"
mount -t tmpfs tmpfs /run 2>/dev/null || fail "mount run"
chmod 700 /run
# DPDK falls back to /var/run when XDG_RUNTIME_DIR is not usable.  Provide
# both locations so EAL works regardless of its detection path.
mkdir -p /var/run/dpdk /var/log /run/dpdk /tmp
ln -sfn /run/dpdk /var/run/dpdk

echo "=== dpdk-tunnel-router VM test suite ==="
uname -a
echo "CPU: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2-)"

cd /project || fail "cd /project"
FAIL=0
run() {
    local name=$1
    shift
    echo "=== TEST $name ==="
    if "$@"; then
        echo "TEST_OK $name"
    else
        echo "TEST_FAIL $name"
        FAIL=1
    fi
}

run test_capture /project/build/core/test_capture
run test_config /project/build/core/test_config
run test_engine /project/build/core/test_engine
run test_fib /project/build/core/test_fib
run test_plugin /project/build/core/test_plugin
run test_reasm /project/build/core/test_reasm
run rust_tunnel_driver /project/build/rust/tests/tunnel_driver --test-threads=1
run rust_routerctl /project/build/rust/tests/routerctl
run smoke /bin/bash /project/scripts/smoke-test.sh

if [ "$FAIL" -eq 0 ]; then
    echo "VM_TESTS_PASS"
else
    echo "VM_TESTS_FAIL"
fi
sync
poweroff -f 2>/dev/null || true
sleep 5
